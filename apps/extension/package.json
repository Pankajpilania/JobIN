{
  "name": "jobin-extension",
  "version": "1.0.0",
  "description": "JobIN Copilot — Chrome Extension (Manifest V3)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node setup-icons.js && vite build --watch --mode development",
    "build": "node setup-icons.js && vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "jose": "^6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@types/chrome": "^0.0.260",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.7"
  }
}
