# Vite build settings. Copy to .env.local. Register an OCI OAuth client using the
# extension redirect URI shown by chrome.identity.getRedirectURL() after publishing.
VITE_API_URL=https://api.jobin.today/api
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_AUTH_PROVIDER=oci
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-extension-client-id
VITE_AUTH0_AUDIENCE=https://api.jobin.today
VITE_OCI_METADATA_URL=https://idcs-77b35fd5fc7c4ca6aff604ac54488c21.identity.oraclecloud.com/.well-known/openid-configuration
VITE_OCI_CLIENT_ID=your-oci-extension-client-id
VITE_OCI_API_SCOPE=https://api.jobin.today/jobin-api
