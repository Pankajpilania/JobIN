# ==================================================
# JOBIN WEB — Environment Variables
# Copy this file to .env.local and fill in real values.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# ==================================================

# ── Supabase credentials (used when the shared web auth provider is supabase) ─
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── OCI IAM Identity Domains (default user web provider) ────────────────────
NEXT_PUBLIC_AUTH_PROVIDER=oci
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-auth0-spa-client-id
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.jobin.today
NEXT_PUBLIC_OCI_METADATA_URL=https://idcs-77b35fd5fc7c4ca6aff604ac54488c21.identity.oraclecloud.com/.well-known/openid-configuration
NEXT_PUBLIC_OCI_CLIENT_ID=9d6149d7708543bfbdde1c79f802d1b0
NEXT_PUBLIC_OCI_API_SCOPE=https://api.jobin.today/jobin-api

# ── Backend API ──────────────────────────────────────────────────────────────
# URL of the NestJS API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=JobIN
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# ── Sentry & PostHog Analytics ────────────────────────────────────────────────
# Optional: set a real Sentry DSN to enable error reporting.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Public Chrome Web Store listing URL; leave empty until the extension is published.
NEXT_PUBLIC_CHROME_EXTENSION_URL=
