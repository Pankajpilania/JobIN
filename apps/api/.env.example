# ==================================================
# JOBIN API — Environment Variables
# Copy this file to .env and fill in real values
# ==================================================

# ── Application ─────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (PostgreSQL) ────────────────────────
DATABASE_URL="postgresql://postgres:your-supabase-db-password@db.your-supabase-project.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your-supabase-db-password@db.your-supabase-project.supabase.co:5432/postgres"

# ── Redis ────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Supabase Authentication ──────────────────────
# Supported values are supabase (default), dual/auth0, oci_dual (staged OCI migration), or oci.
AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
# Used only if SUPABASE_SERVICE_ROLE_KEY is not configured. A public anon key
# is sufficient for validating bearer tokens with auth.getUser().
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Auth0 (only required when AUTH_PROVIDER=auth0) ──
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.jobin.today
# Optional Auth0 Management API client credentials, used to delete Auth0 identities
# from the admin panel. Grant only the delete:users scope.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# ── OCI IAM Identity Domains (required when AUTH_PROVIDER=oci or oci_dual) ──
OCI_ISSUER=https://identity.oraclecloud.com/
OCI_JWKS_URL=https://idcs-77b35fd5fc7c4ca6aff604ac54488c21.identity.oraclecloud.com/admin/v1/SigningCert/jwk
OCI_USERINFO_URL=https://idcs-77b35fd5fc7c4ca6aff604ac54488c21.identity.oraclecloud.com/oauth2/v1/userinfo
OCI_API_AUDIENCE=https://api.jobin.today
OCI_API_SCOPE=https://api.jobin.today/jobin-api
# Dedicated confidential client with the Authenticated Client role, used only to retrieve signing keys.
OCI_JWKS_CLIENT_ID=
OCI_JWKS_CLIENT_SECRET=
# OCI identity-domain base URL; required for signing-key retrieval and optional admin deletion.
OCI_DOMAIN_URL=https://idcs-77b35fd5fc7c4ca6aff604ac54488c21.identity.oraclecloud.com
# Required only for admin deletion of OCI identities. Keep this separate client server-side.
OCI_MANAGEMENT_CLIENT_ID=
OCI_MANAGEMENT_CLIENT_SECRET=

# ── CORS ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Cloudflare R2 (S3-compatible storage) ────────
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=jobin-resumes

# ── Stripe (Payments) ────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_YEARLY=price_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Gemini AI ─────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_PAID_TIER=false
# Set a stable 32-byte base64 or 64-character hex key before saving AI keys in Admin.
AI_SETTINGS_ENCRYPTION_KEY=

# ── Email — Resend ────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@jobin.ai
RESEND_FROM_NAME=JobIN

# ── App URL (used in email links) ─────────────────
NEXT_PUBLIC_URL=http://localhost:3000

# ── Sentry ────────────────────────────────────────
SENTRY_DSN=your-sentry-dsn
