{
  "name": "jobin-api",
  "version": "2.0.0",
  "description": "JobIN NestJS API — Sprint 2",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "npm run db:migrate:deploy && node dist/src/main",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "verify:discount-codes:test-mode": "node --env-file=.env scripts/verify-discount-codes-test-mode.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/mapped-types": "12.0.1",
    "@nestjs/passport": "12.0.1",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/schedule": "12.0.3",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "11.11.0",
    "@supabase/supabase-js": "^2.119.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "docx": "^8.6.0",
    "jose": "^6.2.17",
    "mammoth": "^1.13.0",
    "multer": "2.5.0",
    "oci-common": "^2.145.0",
    "oci-objectstorage": "^2.145.0",
    "passport": "^0.7.0",
    "pdf-parse": "^1.1.4",
    "pdfkit": "^0.20.2",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.37.0",
    "rxjs": "^7.8.2",
    "stripe": "^14.25.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.2",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "^20.19.43",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.7",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "vitest": "^4.1.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
