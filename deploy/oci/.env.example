# OCI Always Free self-hosted PostgreSQL. Use a 64-character hex password:
# openssl rand -hex 32
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=jobin
POSTGRES_USER=jobin
POSTGRES_PASSWORD=replace-with-output-from-openssl-rand-hex-32

# Copy the remaining required API configuration from apps/api/.env.example.
# Store real secrets only in deploy/oci/.env on the OCI VM; never commit that file.
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://jobin.today,https://www.jobin.today
AUTH_PROVIDER=oci_dual
REDIS_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# oci_dual accepts OCI web sign-in and legacy Supabase extension tokens during migration.
# Set AUTH_PROVIDER=oci after the extension client is configured and migrated.
OCI_ISSUER=https://identity.oraclecloud.com/
OCI_DOMAIN_URL=https://idcs-77b35fd5fc7c4ca6aff604ac54488c21.identity.oraclecloud.com
OCI_JWKS_URL=https://idcs-77b35fd5fc7c4ca6aff604ac54488c21.identity.oraclecloud.com/admin/v1/SigningCert/jwk
OCI_USERINFO_URL=https://idcs-77b35fd5fc7c4ca6aff604ac54488c21.identity.oraclecloud.com/oauth2/v1/userinfo
OCI_API_AUDIENCE=https://api.jobin.today
OCI_API_SCOPE=https://api.jobin.today/jobin-api
OCI_AUTH_MODE=instance_principal
OCI_REGION=uk-london-1
OCI_OBJECT_STORAGE_NAMESPACE=lrky3blu0nc9
OCI_OBJECT_STORAGE_BUCKET=jobin-resumes
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_PAID_TIER=false
AI_SETTINGS_ENCRYPTION_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=JobIN
NEXT_PUBLIC_URL=https://www.jobin.today
SENTRY_DSN=
